{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "ask",
      "npm test *": "allow",
      "rm *": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "read": {
      "*": "ask",
      ".": "allow",
      "/tmp": "allow",
      "*.env.example": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.key": "deny",
      "*.pem": "deny"
    },
    "edit": {
      "*": "ask",
      ".": "allow",
      "/tmp": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.key": "deny",
      "*.pem": "deny"
    },
    "external_directory": {
      "~/.local/share/pnpm/**": "allow",
      "~/.local/bin/**": "allow"
    },
    "todoread": "allow",
    "todowrite": "allow",
    "codesearch": "ask",
    "skill": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "task": "deny",
    "doom_loop": "deny"
  },
  "plugin": [
    "opencode-cursor-oauth"
  ],
  "provider": {
    "cursor": {
      "name": "Cursor"
    }
  }
}
