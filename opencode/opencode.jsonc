{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "openai/gpt-6-luna",
  "share": "disabled",
  "permissions": [
    { "action": "read", "resource": "*", "effect": "deny" },
    { "action": "read", "resource": "~/.gpnupg/*", "effect": "deny" },
    { "action": "read", "resource": "~/.password-store/*", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "*.cert*", "effect": "deny" },
    { "action": "read", "resource": "*.db*", "effect": "deny" },
    { "action": "read", "resource": "*.env*", "effect": "deny" },
    { "action": "read", "resource": "*.key*", "effect": "deny" },
    { "action": "read", "resource": "*.pem*", "effect": "deny" },
    { "action": "read", "resource": "*.pub*", "effect": "deny" },
    { "action": "read", "resource": "~/work/*", "effect": "allow" },

    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "~/.gpnupg/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.password-store/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "edit", "resource": "*.cert*", "effect": "deny" },
    { "action": "edit", "resource": "*.db*", "effect": "deny" },
    { "action": "edit", "resource": "*.env*", "effect": "deny" },
    { "action": "edit", "resource": "*.key*", "effect": "deny" },
    { "action": "edit", "resource": "*.pem*", "effect": "deny" },
    { "action": "edit", "resource": "*.pub*", "effect": "deny" },

    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "jj diff *", "effect": "allow" },
    { "action": "shell", "resource": "jj log *", "effect": "allow" },
    { "action": "shell", "resource": "jj show *", "effect": "allow" },
    { "action": "shell", "resource": "jj status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "npm run check*", "effect": "allow" },
    { "action": "shell", "resource": "npm run format*", "effect": "allow" },
    { "action": "shell", "resource": "npm run lint*", "effect": "allow" },
    { "action": "shell", "resource": "npm run test*", "effect": "allow" },
    { "action": "shell", "resource": "npm run typecheck*", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },

    { "action": "glob", "resource": "*", "effect": "ask" },
    { "action": "grep", "resource": "*", "effect": "ask" },
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "ask" },
    { "action": "execute", "resource": "*", "effect": "ask" },

    { "action": "question", "resource": "*", "effect": "allow" },

    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.local/bin/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "$TMPDIR/*", "effect": "allow" },

    { "action": "skill", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "*", "effect": "deny" }
  ]
}
